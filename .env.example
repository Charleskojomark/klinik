# ──────────────────────────────────────────────
# Klinik Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# LLM — vLLM server on AMD MI300X
VLLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
HF_TOKEN=your_huggingface_token

# Redis (local or Redis Cloud)
REDIS_URL=redis://localhost:6379

# LiveKit (use LiveKit Cloud: https://livekit.io)
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Simli — Talking Avatar (https://simli.ai)
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Deepgram — STT + TTS (https://deepgram.com)
DEEPGRAM_API_KEY=

# Twilio — Patient SMS (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Turso — Database (https://turso.tech)
DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Calendly — Scheduling (optional)
CALENDLY_API_KEY=

# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
